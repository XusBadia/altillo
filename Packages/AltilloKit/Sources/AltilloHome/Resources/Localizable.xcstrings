    },
    "Outside your local network, Altillo needs an https:// address for Home Assistant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside your local network, Altillo needs an https:// address for Home Assistant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de tu red local, Altillo necesita una dirección https:// para Home Assistant."
          }
        }
      }
    },
    "That belongs to another Home Assistant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That belongs to another Home Assistant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es de otro Home Assistant."
          }
        }
      }
    },
    "That device can't do this.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device can't do this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese dispositivo no puede hacer eso."
          }
        }
      }
    },
    "That doesn't look like an address. Try something like homeassistant.local:8123.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like an address. Try something like homeassistant.local:8123."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no parece una dirección. Prueba con algo como homeassistant.local:8123."
          }
        }
      }
    },
    "There's no token saved for this server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no token saved for this server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún token guardado para este servidor."
          }
        }
      }
    },
    "This server uses its own certificate. Check it and trust it to continue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server uses its own certificate. Check it and trust it to continue."
