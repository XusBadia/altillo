        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he podido traer la imagen de la cámara."
          }
        }
      }
    },
    "Couldn't save the token in the Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the token in the Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he podido guardar el token en el Llavero."
          }
        }
      }
    },
    "Home Assistant answered something unexpected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant answered something unexpected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant ha respondido algo inesperado."
          }
        }
      }
    },
    "Home Assistant didn't accept that token. Create a new one and paste it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant didn't accept that token. Create a new one and paste it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant no ha aceptado ese token. Crea uno nuevo y vuelve a pegarlo."
          }
        }
      }
    },
    "Home Assistant is taking too long to answer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant is taking too long to answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant tarda demasiado en responder."
          }
        }
      }
    },
