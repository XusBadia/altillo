    },
    "Use an address that starts with http:// or https://.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an address that starts with http:// or https://."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una dirección que empiece por http:// o https://."
          }
        }
