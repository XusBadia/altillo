            "value": "Home Assistant"
          }
        }
      }
    },
    "Home Assistant answered something unexpected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant answered something unexpected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant ha respondido algo inesperado."
          }
        }
      }
    },
    "Home Assistant didn't accept that token. Create a new one and paste it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant didn't accept that token. Create a new one and paste it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant no ha aceptado ese token. Crea uno nuevo y vuelve a pegarlo."
          }
        }
      }
    },
    "Home Assistant didn't finish the sign-in. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant didn't finish the sign-in. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant no ha terminado el inicio de sesión. Inténtalo de nuevo."
          }
