{
  "sourceLanguage": "en",
  "strings": {
    "Altillo needs Local Network access. Turn it on in System Settings → Privacy & Security → Local Network.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Altillo needs Local Network access. Turn it on in System Settings → Privacy & Security → Local Network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altillo necesita acceso a la red local. Actívalo en Ajustes del Sistema → Privacidad y seguridad → Red local."
          }
        }
      }
    },
    "Can't find your Home Assistant at that address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't find your Home Assistant at that address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encuentro tu Home Assistant en esa dirección."
          }
        }
      }
    },
    "Couldn't get the camera image.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't get the camera image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he podido traer la imagen de la cámara."
          }
        }
      }
    },
    "Couldn't open the browser to sign in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open the browser to sign in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he podido abrir el navegador para iniciar sesión."
          }
        }
      }
    },
    "Couldn't save the token in the Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the token in the Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he podido guardar el token en el Llavero."
          }
        }
      }
    },
    "Couldn't start the sign-in. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't start the sign-in. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he podido empezar el inicio de sesión. Inténtalo de nuevo."
          }
        }
      }
    },
    "Done. You can go back to Altillo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. You can go back to Altillo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. Ya puedes volver a Altillo."
          }
        }
      }
    },
    "Home Assistant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
