          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los hooks permiten que un agente le cuente a Altillo qué hace y te pida permiso en el notch. Sin ellos, Altillo sigue mostrando tus sesiones a partir de los ficheros de sesión de los agentes, pero no puede aprobar nada."
          }
        }
      }
