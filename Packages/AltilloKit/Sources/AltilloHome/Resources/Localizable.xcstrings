    },
    "Not connected to Home Assistant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected to Home Assistant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay conexión con Home Assistant."
          }
        }
      }
    },
    "Outside your local network, Altillo needs an https:// address for Home Assistant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside your local network, Altillo needs an https:// address for Home Assistant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de tu red local, Altillo necesita una dirección https:// para Home Assistant."
          }
        }
      }
    },
    "Something answers at that address, but it isn't Home Assistant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something answers at that address, but it isn't Home Assistant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo responde en esa dirección, pero no es Home Assistant."
          }
        }
      }
    },
    "That belongs to another Home Assistant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That belongs to another Home Assistant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso es de otro Home Assistant."
          }
        }
      }
    },
    "That device can't do this.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device can't do this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese dispositivo no puede hacer eso."
          }
        }
      }
    },
    "That doesn't look like an address. Try something like homeassistant.local:8123.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like an address. Try something like homeassistant.local:8123."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no parece una dirección. Prueba con algo como homeassistant.local:8123."
          }
        }
      }
    },
    "The sign-in didn't finish. Go back to Altillo and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in didn't finish. Go back to Altillo and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión no ha terminado. Vuelve a Altillo e inténtalo de nuevo."
          }
        }
      }
    },
    "The sign-in took too long. Try again when you're ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in took too long. Try again when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión ha tardado demasiado. Inténtalo de nuevo cuando quieras."
          }
        }
      }
    },
    "The sign-in was cancelled in Home Assistant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in was cancelled in Home Assistant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha cancelado el inicio de sesión en Home Assistant."
          }
        }
      }
    },
    "There's no token saved for this server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no token saved for this server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún token guardado para este servidor."
          }
        }
      }
    },
    "This Home Assistant isn't set up yet. Finish its setup in the browser first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Home Assistant isn't set up yet. Finish its setup in the browser first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Home Assistant aún no está configurado. Termina primero su configuración en el navegador."
          }
        }
      }
    },
    "This server uses its own certificate. Check it and trust it to continue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server uses its own certificate. Check it and trust it to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa su propio certificado. Revísalo y confía en él para seguir."
          }
        }
      }
    },
    "Type your Home Assistant address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type your Home Assistant address."
