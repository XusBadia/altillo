{
  "sourceLanguage": "en",
  "strings": {
    "Altillo needs Local Network access. Turn it on in System Settings → Privacy & Security → Local Network.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Altillo needs Local Network access. Turn it on in System Settings → Privacy & Security → Local Network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altillo necesita acceso a la red local. Actívalo en Ajustes del Sistema → Privacidad y seguridad → Red local."
          }
        }
      }
    },
    "Can't find your Home Assistant at that address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't find your Home Assistant at that address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encuentro tu Home Assistant en esa dirección."
          }
        }
      }
    },
    "Couldn't get the camera image.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't get the camera image."
          }
